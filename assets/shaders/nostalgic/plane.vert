#version 300 es

// Полноэкранная плоскость на заданной глубине — для NostalgicRenderer.
//
// Глубина и есть весь смысл: одна такая плоскость в проходе подсчёта размечает внешний
// обод клеток, другая накладывает затемнение только там, где под ней частица, а не фон.

in vec4 a_position;

/** Глубина окна, 0..1. */
uniform float u_depth;

void main() {
    gl_Position = vec4(a_position.xy, u_depth * 2.0 - 1.0, 1.0);
}
