#version 300 es
precision highp float;

// Заливка клетки ностальгического режима: цвет и чёрное ядро.
//
// ГЛУБИНА СЧИТАЕТСЯ ЗДЕСЬ, ТОЧНО
// ------------------------------
// Буфер глубины по-прежнему строит диаграмму Вороного как argmin d/R (см. circle_pc.vert),
// но d/R берётся не интерполяцией по многоугольному конусу, а точно — length() от
// локальной координаты. Интерполированный конус ошибается до 1 - cos(π/N), и на сильном
// приближении это было видно: края контура шли волной с периодом граней многоугольника.
// Теперь окружности, границы между клетками и контур — точные.
//
// Цена — early-Z: при записи gl_FragDepth и discard фрагменты перекрытых клеток уже не
// отбрасываются до шейдера. В реалистичном режиме ради early-Z от этого и ушли, потому
// что там фрагмент дорогой (массив текстур, два перевода в HSV). Здесь же фрагмент — это
// length(), сравнение и запись цвета, а геометрия зато стала восьмиугольником вместо
// веера на 32 сегмента. Замер — в шапке NostalgicRenderer.
//
// Контура здесь нет: его размечают в stencil следующие проходы NostalgicRenderer.

in vec2 ex_Local;
flat in vec3 ex_Color;
flat in float ex_Nucleus;

/** Глубина окна = (d/R + u_depthBias) * u_depthScale. Смысл подъёма — в NostalgicRenderer. */
uniform float u_depthBias;
uniform float u_depthScale;

out vec4 fragColor;

void main() {
    float d = length(ex_Local);

    // Корпус — восьмиугольник вокруг круга; всё, что за окружностью, не клетка.
    if (d > 1.0) discard;

    gl_FragDepth = (d + u_depthBias) * u_depthScale;

    // Ядро без сглаживания: силуэт и границы клеток тоже попиксельные. У не-клетки
    // ex_Nucleus отрицательный, и условие не выполняется никогда.
    fragColor = vec4(d < ex_Nucleus ? vec3(0.0) : ex_Color, 1.0);
}
